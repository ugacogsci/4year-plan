{"subject":"CW","courses":[{"code":"CW 100","subject":"CW","number":"100","level":100,"title":"Intro to Creative Writing","credits":3,"creditsMax":3,"description":"Acquaints students with the technical choices a writer makes in creating a story or a poem. Classes will consist of lectures on specific elements of poetry, fiction, and creative nonfiction. Students will also have the opportunity to talk with visiting writers and work in small groups to apply the course techniques and skills to a close reading of stories and poems.","prereqCodes":[],"prereqText":"","prereqNote":"","genEd":["Humanities - Lit & Arts"],"sameAs":[],"noise":false,"url":"https://catalog.illinois.edu/courses-of-instruction/cw/"},{"code":"CW 104","subject":"CW","number":"104","level":100,"title":"Fiction Workshop I","credits":3,"creditsMax":3,"description":"An introductory workshop in fiction, with a primary emphasis on short stories.","prereqCodes":[],"prereqText":"Completion of campus Composition I general education requirement.","prereqNote":"","genEd":[],"sameAs":[],"noise":false,"url":"https://catalog.illinois.edu/courses-of-instruction/cw/"},{"code":"CW 106","subject":"CW","number":"106","level":100,"title":"Poetry Workshop I","credits":3,"creditsMax":3,"description":"Practice in the writing of poetry; experimentation with a number of fixed forms and free verse, but emphasis mainly on the student's freedom to develop a personal style.","prereqCodes":[],"prereqText":"Completion of campus Composition I general education requirement.","prereqNote":"","genEd":[],"sameAs":[],"noise":false,"url":"https://catalog.illinois.edu/courses-of-instruction/cw/"},{"code":"CW 199","subject":"CW","number":"199","level":100,"title":"Undergraduate Open Seminar","credits":1,"creditsMax":5,"description":"Topics course that varies each semester and by section. The topics offered each semester will be listed in the Class Schedule. Approved for Letter and S/U grading. May be repeated.","prereqCodes":[],"prereqText":"","prereqNote":"","genEd":[],"sameAs":[],"noise":false,"url":"https://catalog.illinois.edu/courses-of-instruction/cw/"},{"code":"CW 200","subject":"CW","number":"200","level":200,"title":"Reading for Writers","credits":3,"creditsMax":3,"description":"Emphasizes the craft of short stories and poems through the study of formal elements central to the production of creative writing (e.g., plot, character, setting, point of view in short fiction and rhythm, meter, line break, imagery, simile, metaphor, formal patterns in poetry).","prereqCodes":["CW 104","CW 106"],"prereqText":"CW 104 or CW 106. For majors only.","prereqNote":"","genEd":[],"sameAs":[],"noise":false,"url":"https://catalog.illinois.edu/courses-of-instruction/cw/"},{"code":"CW 202","subject":"CW","number":"202","level":200,"title":"Topics in Creative Writing","credits":3,"creditsMax":3,"description":"Independent writing projects and examination of literature as the cultural basis of the student's specialized fields. May be repeated as topics vary.","prereqCodes":[],"prereqText":"","prereqNote":"","genEd":[],"sameAs":[],"noise":false,"url":"https://catalog.illinois.edu/courses-of-instruction/cw/"},{"code":"CW 204","subject":"CW","number":"204","level":200,"title":"Fiction Workshop II","credits":3,"creditsMax":3,"description":"An intermediate workshop in fiction, with a primary emphasis on short stories.","prereqCodes":["CW 104"],"prereqText":"CW 104 or equivalent.","prereqNote":"","genEd":[],"sameAs":[],"noise":false,"url":"https://catalog.illinois.edu/courses-of-instruction/cw/"},{"code":"CW 206","subject":"CW","number":"206","level":200,"title":"Poetry Workshop II","credits":3,"creditsMax":3,"description":"Builds upon the workshop format of CW 106, with an emphasis on prosody and poetic technique. Students will deepen their sense of craft by putting into practice their study and understanding of a variety of poetic forms (e.g., syllabic poetry, dramatic monologue, sonnet, bound/free verse) and technical concerns (e.g., voice, tone, line, line break, image). The workshop component of the course typically includes 8-12 completed poems and their revisions.","prereqCodes":["CW 106"],"prereqText":"CW 106.","prereqNote":"","genEd":[],"sameAs":[],"noise":false,"url":"https://catalog.illinois.edu/courses-of-instruction/cw/"},{"code":"CW 208","subject":"CW","number":"208","level":200,"title":"Creative Nonfiction Workshop","credits":3,"creditsMax":3,"description":"Types of nonfiction prose, including the personal essay, memoir, literary journalism, and historical writing.","prereqCodes":[],"prereqText":"","prereqNote":"","genEd":[],"sameAs":[],"noise":false,"url":"https://catalog.illinois.edu/courses-of-instruction/cw/"},{"code":"CW 243","subject":"CW","number":"243","level":200,"title":"The Craft Essay: Creative Reading, Reflection, and Revision","credits":3,"creditsMax":3,"description":"In this writing- and reading-intensive composition class, students will look at how creative writers—fiction writers, poets, and essayists—write about creative writing outside of the standard literary analysis model. Realizing that there are other methods of discussing, analyzing, and considering literature is a major goal of this class. As a complement to the production of creative work, students will focus on how we analyze, consider, and place that work within the greater context of creative writing.","prereqCodes":[],"prereqText":"Completion of campus Composition I general education requirement.","prereqNote":"","genEd":["Advanced Composition"],"sameAs":[],"noise":false,"url":"https://catalog.illinois.edu/courses-of-instruction/cw/"},{"code":"CW 404","subject":"CW","number":"404","level":400,"title":"Fiction Workshop III","credits":3,"creditsMax":4,"description":"An advanced workshop in fiction, with a primary emphasis on short stories. 3 undergraduate hours. 4 graduate hours. May be repeated for a maximum of 6 undergraduate hours or 8 graduate hours.","prereqCodes":["CW 204"],"prereqText":"CW 204 or equivalent.","prereqNote":"","genEd":[],"sameAs":[],"noise":false,"url":"https://catalog.illinois.edu/courses-of-instruction/cw/"},{"code":"CW 406","subject":"CW","number":"406","level":400,"title":"Poetry Workshop III","credits":3,"creditsMax":4,"description":"Practice of the writing of poetry aided by intensive study of examples. 3 undergraduate hours. 4 graduate hours. May be repeated to a maximum of 6 undergraduate hours or 8 graduate hours.","prereqCodes":["CW 206"],"prereqText":"CW 206 or equivalent.","prereqNote":"","genEd":[],"sameAs":[],"noise":false,"url":"https://catalog.illinois.edu/courses-of-instruction/cw/"},{"code":"CW 455","subject":"CW","number":"455","level":400,"title":"Creative Writing Tutorial","credits":3,"creditsMax":4,"description":"Personal direction in a writing project: fiction (novel or short stories), poetry or creative nonfiction. Frequency of conference to be determined by the type of project. 3 undergraduate hours. 4 graduate hours. May be repeated to a maximum of 6 undergraduate hours or 8 graduate hours.","prereqCodes":["CW 208","CW 404","CW 406"],"prereqText":"CW 208, CW 404 or CW 406, and consent of the Director of Creative Writing.","prereqNote":"","genEd":[],"sameAs":[],"noise":false,"url":"https://catalog.illinois.edu/courses-of-instruction/cw/"},{"code":"CW 460","subject":"CW","number":"460","level":400,"title":"Intro to Literary Editing","credits":3,"creditsMax":3,"description":"Practicum in which students learn all the stages of developing and editing a literary publication. Students will solicit, read, and select poems and stories for an online supplement to the Ninth Letter literary journal. At the end of the semester, the supplement will be published on the Ninth Letter website (www.ninthletter.com). Students will gain experience in professional communications, copyediting, and marketing. 3 undergraduate hours. No graduate credit. May be repeated in separate semesters to a maximum of 6 hours.","prereqCodes":["CW 104","CW 106"],"prereqText":"CW 104 or CW 106.","prereqNote":"","genEd":[],"sameAs":[],"noise":false,"url":"https://catalog.illinois.edu/courses-of-instruction/cw/"},{"code":"CW 463","subject":"CW","number":"463","level":400,"title":"Adv Topics in Creative Writing","credits":3,"creditsMax":4,"description":"Advanced topics course in Creative Writing. Students study selected topic through a workshop model, pursuing advanced development in one or more approaches to writing in a specialized field or genre. 3 undergraduate hours. 4 graduate hours. May be repeated, if topics vary.","prereqCodes":[],"prereqText":"Junior standing required.","prereqNote":"","genEd":[],"sameAs":[],"noise":false,"url":"https://catalog.illinois.edu/courses-of-instruction/cw/"},{"code":"CW 500","subject":"CW","number":"500","level":500,"title":"The Craft of Fiction","credits":4,"creditsMax":4,"description":"Examination of the creative process of fiction from the perspectives of aesthetics and techniques, illustrated from the work of selected authors.","prereqCodes":[],"prereqText":"Graduate standing in English.","prereqNote":"","genEd":[],"sameAs":[],"noise":false,"url":"https://catalog.illinois.edu/courses-of-instruction/cw/"},{"code":"CW 502","subject":"CW","number":"502","level":500,"title":"Problems in Poetry Writing","credits":4,"creditsMax":4,"description":"Examination of the creative process of poetry from the perspective of aesthetics and techniques, illustrated from the work of selected authors.","prereqCodes":[],"prereqText":"Graduate standing in English.","prereqNote":"","genEd":[],"sameAs":[],"noise":false,"url":"https://catalog.illinois.edu/courses-of-instruction/cw/"},{"code":"CW 504","subject":"CW","number":"504","level":500,"title":"Writing Workshop in Fiction","credits":4,"creditsMax":4,"description":"Directed individual projects, with group discussion in fiction. May be repeated to a maximum of 16 hours.","prereqCodes":[],"prereqText":"Admission to the MFA program, or graduate standing in English with advanced submission of creative work and consent of instructor.","prereqNote":"","genEd":[],"sameAs":[],"noise":false,"url":"https://catalog.illinois.edu/courses-of-instruction/cw/"},{"code":"CW 506","subject":"CW","number":"506","level":500,"title":"Writing Workshop in Poetry","credits":4,"creditsMax":4,"description":"Directed individual projects, with group discussion in poetry. May be repeated to a maximum of 16 hours.","prereqCodes":[],"prereqText":"Admission to the MFA program, or graduate standing in English with advanced submission of creative work and consent of instructor.","prereqNote":"","genEd":[],"sameAs":[],"noise":false,"url":"https://catalog.illinois.edu/courses-of-instruction/cw/"},{"code":"CW 560","subject":"CW","number":"560","level":500,"title":"Literary Publishing &Promotion","credits":0,"creditsMax":4,"description":"A working practicum designed to teach graduate students the basics of literary journal publishing and to introduce them to career and entrepreneurial opportunities in other types of literary arts organizations. Students will attend weekly editorial meetings, complete weekly reading assignments, and will work 2 hours per week in the 'Ninth Letter' office, reading manuscript submissions and completing various clerical tasks for the journal. Approved for both letter and S/U grading. May be repeated to a maximum of 8 hours.","prereqCodes":[],"prereqText":"MFA candidate standing.","prereqNote":"","genEd":[],"sameAs":[],"noise":false,"url":"https://catalog.illinois.edu/courses-of-instruction/cw/"},{"code":"CW 563","subject":"CW","number":"563","level":500,"title":"Special Topics","credits":0,"creditsMax":4,"description":"Approved for both letter and S/U grading. May be repeated up to a maximum of 12 hours.","prereqCodes":[],"prereqText":"MFA candidate standing or consent of instructor.","prereqNote":"","genEd":[],"sameAs":[],"noise":false,"url":"https://catalog.illinois.edu/courses-of-instruction/cw/"},{"code":"CW 591","subject":"CW","number":"591","level":500,"title":"Independent Study","credits":0,"creditsMax":4,"description":"Approved for both letter and S/U grading. May be repeated up to a maximum of 12 hours.","prereqCodes":[],"prereqText":"MFA candidate standing.","prereqNote":"","genEd":[],"sameAs":[],"noise":true,"url":"https://catalog.illinois.edu/courses-of-instruction/cw/"},{"code":"CW 595","subject":"CW","number":"595","level":500,"title":"Final Project","credits":0,"creditsMax":12,"description":"Guidance in writing final projects. Approved for S/U grading only. May be repeated in separate terms to a maximum of 12 hours.","prereqCodes":[],"prereqText":"MFA candidate standing.","prereqNote":"","genEd":[],"sameAs":[],"noise":false,"url":"https://catalog.illinois.edu/courses-of-instruction/cw/"}],"sections":[{"code":"CW 100","subject":"CW","number":"100","sections":[{"crn":"79779","type":"Lecture-Discussion","section":"B","start":"9:30AM","end":"10:45AM","days":"TR","room":"36","building":"English Building","meetings":[{"days":"TR","start":"9:30AM","end":"10:45AM","room":"36","building":"English Building"}],"instructors":["Simon, Z"],"partOfTerm":"1","dateRange":"08/24/26-12/09/26","availability":"Closed"},{"crn":"80940","type":"Lecture-Discussion","section":"C","start":"11:00AM","end":"12:15PM","days":"TR","room":"259","building":"English Building","meetings":[{"days":"TR","start":"11:00AM","end":"12:15PM","room":"259","building":"English Building"}],"instructors":["Martin, C"],"partOfTerm":"1","dateRange":"08/24/26-12/09/26","availability":"Closed"},{"crn":"67101","type":"Lecture-Discussion","section":"D","start":"11:00AM","end":"12:15PM","days":"TR","room":"36","building":"English Building","meetings":[{"days":"TR","start":"11:00AM","end":"12:15PM","room":"36","building":"English Building"}],"instructors":["Dudek, J"],"partOfTerm":"1","dateRange":"08/24/26-12/09/26","availability":"Open (Restricted)"},{"crn":"77317","type":"Lecture-Discussion","section":