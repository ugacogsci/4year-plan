{"subject":"BIOP","courses":[{"code":"BIOP 401","subject":"BIOP","number":"401","level":400,"title":"Introduction to Biophysics","credits":3,"creditsMax":3,"description":"Topics include equilibrium thermodynamics, kinetics, and quantum mechanics with applications to biological and chemical systems. 3 undergraduate hours. 3 graduate hours.","prereqCodes":["MCB 354","MCB 450"],"prereqText":"MCB 354 or MCB 450, or equivalent, or consent of instructor.","prereqNote":"","genEd":[],"sameAs":[],"noise":false,"url":"https://catalog.illinois.edu/courses-of-instruction/biop/"},{"code":"BIOP 432","subject":"BIOP","number":"432","level":400,"title":"Photosynthesis","credits":3,"creditsMax":3,"description":"Comprehensive description of photosynthesis. Topics include: the photosynthetic membranes, light absorption, electron and proton transfer, photophosphorylation, water oxidation, RUBP carboxylase/oxygenase, photorespiration, whole plant photosynthesis, gas exchange and atmospheric interactions, and impacts of global environmental change. 3 undergraduate hours. 3 graduate hours.","prereqCodes":["IB 420","MCB 354","MCB 450","BIOP 401"],"prereqText":"IB 420, MCB 354, MCB 450, BIOP 401, or equivalent; or consent of instructor.","prereqNote":"","genEd":[],"sameAs":["CPSC 489"],"noise":false,"url":"https://catalog.illinois.edu/courses-of-instruction/biop/","canonical":"IB 421","pointerText":"Same as CPSC 489 and IB 421. See IB 421.","descriptionFrom":"IB 421"},{"code":"BIOP 550","subject":"BIOP","number":"550","level":500,"title":"Biomolecular Physics","credits":4,"creditsMax":4,"description":"Physical concepts governing the structure and function of biological macromolecules; general properties, spatial structure, energy levels, dynamics and functions, and relation to other complex physical systems such as glasses; recent research in biomolecular physics; physical techniques and concepts from theoretical physics emphasized.","prereqCodes":["CHEM 104","PHYS 485","PHYS 487"],"prereqText":"CHEM 104; PHYS 485 or PHYS 487.","prereqNote":"","genEd":[],"sameAs":["MCB 550"],"noise":false,"url":"https://catalog.illinois.edu/courses-of-instruction/biop/","canonical":"PHYS 550","pointerText":"Same as MCB 550 and PHYS 550. See PHYS 550.","descriptionFrom":"PHYS 550"},{"code":"BIOP 576","subject":"BIOP","number":"576","level":500,"title":"Computational Chemical Biology","credits":4,"creditsMax":4,"description":"Hands-on introduction to the simulation of biological molecules and bioinformatics. Topics included the principles of molecular modeling, molecular dynamics and monte carlo simulations, structure prediction in the context of structural and functional genomics, and the assembly of integrated biological systems. Course counts towards the CSE option.","prereqCodes":["CS 101"],"prereqText":"One semester of undergraduate biochemistry and statistical thermodynamics or consent of instructor. Recommended: proficiency in Matlab and CS 101 or equivalent.","prereqNote":"","genEd":[],"sameAs":["CHEM 576"],"noise":false,"url":"https://catalog.illinois.edu/courses-of-instruction/biop/","canonical":"CHEM 576","pointerText":"Same as CHEM 576 and CSE 576. See CHEM 576.","descriptionFrom":"CHEM 576"},{"code":"BIOP 581","subject":"BIOP","number":"581","level":500,"title":"Lab Rotation I","credits":2,"creditsMax":2,"description":"Laboratory research methods; familiarization of first-year graduate students with experimental methods used in research in Biophysics and Quantitative Biology. Required of all first-year students majoring in Biophysics and Quantitative Biology. First five weeks of fall term.","prereqCodes":["BIOP 582","BIOP 583"],"prereqText":"First-year graduate status and consent of department; concurrent registration in BIOP 582 and BIOP 583.","prereqNote":"","genEd":[],"sameAs":[],"noise":false,"url":"https://catalog.illinois.edu/courses-of-instruction/biop/"},{"code":"BIOP 582","subject":"BIOP","number":"582","level":500,"title":"Lab Rotation II","credits":2,"creditsMax":2,"description":"Laboratory research methods; familiarization of first-year graduate students with experimental methods used in research in Biophysics and Quantitative Biology. Required of all first-year students majoring in Biophysics and Quantitative Biology. Second five weeks of fall term.","prereqCodes":["BIOP 581","BIOP 583"],"prereqText":"First-year graduate status and consent of department; concurrent registration in BIOP 581 and BIOP 583.","prereqNote":"","genEd":[],"sameAs":[],"noise":false,"url":"https://catalog.illinois.edu/courses-of-instruction/biop/"},{"code":"BIOP 583","subject":"BIOP","number":"583","level":500,"title":"Lab Rotation III","credits":2,"creditsMax":2,"description":"Laboratory research methods; familiarization of first-year graduate students with experimental methods used in research in Biophysics and Quantitative Biology. Required of all first-year students majoring in Biophysics and Quantitative Biology. Meets last five weeks of the fall term.","prereqCodes":["BIOP 581","BIOP 582"],"prereqText":"First-year graduate status and consent of department; concurrent registration in BIOP 581 and BIOP 582.","prereqNote":"","genEd":[],"sameAs":[],"noise":false,"url":"https://catalog.illinois.edu/courses-of-instruction/biop/"},{"code":"BIOP 586","subject":"BIOP","number":"586","level":500,"title":"Special Topics in Biophysics","credits":1,"creditsMax":4,"description":"Advanced course/tutorials on topics of interest in biophysics, such as electrophysiology, radiation biology, bioenergetics, protein structure, or the physics of muscular contraction. May be repeated.","prereqCodes":[],"prereqText":"Consent of instructor.","prereqNote":"","genEd":[],"sameAs":[],"noise":false,"url":"https://catalog.illinois.edu/courses-of-instruction/biop/"},{"code":"BIOP 590","subject":"BIOP","number":"590","level":500,"title":"Individual Topics","credits":2,"creditsMax":10,"description":"For graduate students wishing to study individual problems or topics not assigned in other courses. May be repeated.","prereqCodes":[],"prereqText":"Consent of department.","prereqNote":"","genEd":[],"sameAs":[],"noise":true,"url":"https://catalog.illinois.edu/courses-of-instruction/biop/"},{"code":"BIOP 595","subject":"BIOP","number":"595","level":500,"title":"Biophysics Seminars","credits":1,"creditsMax":2,"description":"Survey of literature in one area of biophysics, with special emphasis on student reports. Approved for S/U grading only. May be repeated.","prereqCodes":[],"prereqText":"Graduate standing in Biophysics and Quantitative Biology.","prereqNote":"","genEd":[],"sameAs":[],"noise":false,"url":"https://catalog.illinois.edu/courses-of-instruction/biop/"},{"code":"BIOP 599","subject":"BIOP","number":"599","level":500,"title":"Thesis Research","credits":0,"creditsMax":16,"description":"Research may be conducted in any area under investigation in a faculty laboratory, subject to the approval of the faculty member concerned and the department in which the research is to be done. Approved for S/U grading only. May be repeated in the same term or in separate terms.","prereqCodes":[],"prereqText":"","prereqNote":"","genEd":[],"sameAs":[],"noise":true,"url":"https://catalog.illinois.edu/courses-of-instruction/biop/"}],"sections":[{"code":"BIOP 401","subject":"BIOP","number":"401","sections":[{"crn":"75225","type":"Discussion/Recitation","section":"ADA","start":"2:00PM","end":"2:50PM","days":"F","room":"2200","building":"Sidney Lu Mech Engr Bldg","meetings":[{"days":"F","start":"2:00PM","end":"2:50PM","room":"2200","building":"Sidney Lu Mech Engr Bldg"}],"instructors":["Wu, N"],"partOfTerm":"1","dateRange":"08/24/26-12/09/26","availability":"Open"},{"crn":"75226","type":"Discussion/Recitation","section":"ADB","start":"3:00PM","end":"3:50PM","days":"F","room":"2200","building":"Sidney Lu Mech Engr Bldg","meetings":[{"days":"F","start":"3:00PM","end":"3:50PM","room":"2200","building":"Sidney Lu Mech Engr Bldg"}],"instructors"