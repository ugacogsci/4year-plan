{"subject":"BTW","courses":[{"code":"BTW 199","subject":"BTW","number":"199","level":100,"title":"Undergraduate Open Seminar","credits":1,"creditsMax":5,"description":"May be repeated.","prereqCodes":[],"prereqText":"","prereqNote":"","genEd":[],"sameAs":[],"noise":false,"url":"https://catalog.illinois.edu/courses-of-instruction/btw/"},{"code":"BTW 250","subject":"BTW","number":"250","level":200,"title":"Principles Bus Comm","credits":3,"creditsMax":3,"description":"Teaches students to apply the principles of successful professional communication to workplace writing tasks. Students will also practice editing and supervising the writing of others. Assignments replicate typical business cases and situations, including a report that requires students to compile and interpret research.","prereqCodes":[],"prereqText":"Sophomore standing and completion of campus Composition I requirement.","prereqNote":"","genEd":["Advanced Composition"],"sameAs":[],"noise":false,"url":"https://catalog.illinois.edu/courses-of-instruction/btw/"},{"code":"BTW 261","subject":"BTW","number":"261","level":200,"title":"Principles Tech Comm","credits":3,"creditsMax":3,"description":"Teaches students to apply the principles of successful professional writing to a range of realistic cases in technical communication. Emphasizes flexible problem-solving skills and a clear style for communicating technical information to a range of readers. Assignments will include correspondence, instructions, proposals, and a technical report or similar project.","prereqCodes":[],"prereqText":"Sophomore standing and completion of campus Composition I requirement.","prereqNote":"","genEd":["Advanced Composition"],"sameAs":[],"noise":false,"url":"https://catalog.illinois.edu/courses-of-instruction/btw/"},{"code":"BTW 263","subject":"BTW","number":"263","level":200,"title":"Writing in the Disciplines","credits":3,"creditsMax":3,"description":"Teaches students to apply principles of professional communication to the writing tasks typical of specific disciplines or professions. Assignments will vary, depending on the focus of the course, but will include a substantial report or project.","prereqCodes":[],"prereqText":"Sophomore standing and completion of campus Composition I requirement.","prereqNote":"","genEd":["Advanced Composition"],"sameAs":[],"noise":false,"url":"https://catalog.illinois.edu/courses-of-instruction/btw/"},{"code":"BTW 271","subject":"BTW","number":"271","level":200,"title":"Persuasive Writing","credits":3,"creditsMax":3,"description":"Students will study principles of persuasion as applied to writing and designing written communications for business and the professions. Included are ads, direct-mail campaigns, argumentative essays, proposals, and other types of writing designed to move readers to action.","prereqCodes":[],"prereqText":"Sophomore standing and completion of Composition I requirement.","prereqNote":"","genEd":[],"sameAs":[],"noise":false,"url":"https://catalog.illinois.edu/courses-of-instruction/btw/"},{"code":"BTW 279","subject":"BTW","number":"279","level":200,"title":"Writing Job Applications","credits":1,"creditsMax":1,"description":"Theories and practical techniques of writing successful cover letters and resumes. Emphasizes adaptable communication and research skills, including use of career resources, investigation of potential employers, selection of appropriate jobs that fit students’ skills and interests, and targeting of resumes and cover letters to particular job applications. Same as LAS 279.","prereqCodes":[],"prereqText":"","prereqNote":"","genEd":[],"sameAs":["LAS 279"],"noise":false,"url":"https://catalog.illinois.edu/courses-of-instruction/btw/"},{"code":"BTW 290","subject":"BTW","number":"290","level":200,"title":"Individual Study","credits":0,"creditsMax":3,"description":"Independent research with a chosen tutor leading to the writing of a formal report or preparation of some other type of major presentation of information. Enroll in BTW office, 294 English Building. Approved for both letter and S/U grading. May be repeated to a maximum of 6 hours.","prereqCodes":[],"prereqText":"Consent of instructor.","prereqNote":"","genEd":[],"sameAs":[],"noise":true,"url":"https://catalog.illinois.edu/courses-of-instruction/btw/"},{"code":"BTW 360","subject":"BTW","number":"360","level":300,"title":"Writing for Digital Media","credits":3,"creditsMax":3,"description":"Students will build a professional online web presence and familiarize themselves with social media management. Explores how principles of effective composition and writing as a process interact with different, increasingly popular digital media. In addition to hands-on activities and practice with digital design and web development techniques, students will create social media campaigns, write reports that visualize data, and analyze the diverse audiences that make up the internet. Credit is not given toward graduation for BTW 360 and BTW 285.","prereqCodes":[],"prereqText":"Composition I.","prereqNote":"","genEd":["Advanced Composition"],"sameAs":[],"noise":false,"url":"https://catalog.illinois.edu/courses-of-instruction/btw/"},{"code":"BTW 380","subject":"BTW","number":"380","level":300,"title":"Global Business Communication","credits":3,"creditsMax":3,"description":"How do professionals working internationally negotiate, express disagreement, and maintain relationships? How do management strategies, marketing plans, and human resource decisions differ from one country to another? This class answers these questions and many more about culture, business, and writing. With a strong focus on written communication, this course focuses on current trends in international business management and an array of writing skills and activities to prepare students to succeed in international careers.","prereqCodes":[],"prereqText":"Completion of the campus Composition I requirement. Restricted to students with Sophomore, Junior, or Senior class standing.","prereqNote":"","genEd":["Advanced Composition"],"sameAs":[],"noise":false,"url":"https://catalog.illinois.edu/courses-of-instruction/btw/"},{"code":"BTW 402","subject":"BTW","number":"402","level":400,"title":"Descriptive English Grammar","credits":3,"creditsMax":4,"description":"An introduction to English linguistics with emphasis on the phonetic, syntactic, and semantic structures of English; language variation, standardization, and change; language legislation and linguistic rights; English as a world language; and the study of language in American schools. 3 undergraduate hours. 4 graduate hours.","prereqCodes":[],"prereqText":"","prereqNote":"","genEd":[],"sameAs":["ENGL 402"],"noise":false,"url":"https://catalog.illinois.edu/courses-of-instruction/btw/","canonical":"ENGL 402","pointerText":"Same as ENGL 402. See ENGL 402.","descriptionFrom":"ENGL 402"},{"code":"BTW 490","subject":"BTW","number":"490","level":400,"title":"Special Topics Prof Writing","credits":3,"creditsMax":4,"description":"Study of the forms, situations, and social practices that define writing in particular disciplines or professions. Each class will focus on a specific topic such as science writing, writing in the environmental movement, legal writing, writing in the social sciences, public policy in the popular media, and so on. Assignments will vary with the topic. 3 undergraduate hours. 4 graduate hours. May be repeated to a maximum of 6 undergraduate hours or 8 graduate hours.","prereqCodes":[],"prereqText":"Junior standing.","prereqNote":"","genEd":[],"sameAs":[],"noise":false,"url":"https://catalog.illinois.edu/courses-of-instruction/btw/"}],"sections":[{"code":"BTW 250","subject":"BTW","number":"250","sections":[{"crn":"37989","type":"Lecture-Discussion","section":"C1","start":"10:00AM","end":"10:50AM","days":"MWF","room":"69","building":"English Building","meetings":[{"days":"MWF","start":"10:00AM","end":"10:50AM","room":"69","building":"English Building"}],"instructors":