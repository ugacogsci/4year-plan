{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "orion",
  "main": "worker.ts",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://orion.cogsci.workers.dev"
  },
  "d1_databases": [{
    "binding": "INSIGHTS_DB",
    "database_name": "orion-insights",
    "database_id": "6b65ee99-644a-48a9-9fd1-079ed57df3b7",
    "migrations_dir": "migrations"
  }, {
    "binding": "ACCOUNTS_DB",
    "database_name": "orion-accounts",
    "database_id": "e196fccd-9d44-40f9-a81d-578b24989b4c",
    "migrations_dir": "account-migrations"
  }],
  "triggers": { "crons": ["17 4 * * *"] },
  "env": {
    "insights_local": {
      "name": "orion-insights-local",
      "vars": { "NEXT_PUBLIC_SITE_URL": "http://localhost:3001" },
      "d1_databases": [{ "binding": "INSIGHTS_DB", "database_name": "orion-insights-local", "database_id": "00000000-0000-0000-0000-000000000001", "migrations_dir": "migrations" }]
    }
  }
}
