NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transcript reading, ALMA (the assistant) and university answers run on
# Claude. Leave this unset and all three stay off, and the planner says so.
ANTHROPIC_API_KEY=

# Questions about the university itself (deadlines, policies, offices) are
# answered by the planner's own lookup with the same key: one Claude API call
# whose web search is limited to the school's official domains. It runs under
# the same daily spending cap as ALMA. Optional: the model it uses (default
# claude-sonnet-5-5, measured as good as Opus on these questions for a
# quarter of the cost).
PLANNER_LOOKUP_MODEL=

# The most the planner may spend on the Claude API in one day, in US dollars,
# across ALMA, transcript reading and university answers (default 25; 0 stops
# every call).
PLANNER_DAILY_SPEND_USD=
