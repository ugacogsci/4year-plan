NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Transcript reading and ALMA, the assistant, both run on Claude. Leave this
# unset and both stay switched off, and the planner says so where they would be.
ANTHROPIC_API_KEY=

# Where ALMA sends questions about the university itself: the origin of a TRU
# deployment you run yourself. Every question forwarded there is answered on
# that deployment's model budget, so do not point this at someone else's site.
# Unset, the planner answers only from the board and says it cannot reach the
# university's pages.
TRU_UPSTREAM=
